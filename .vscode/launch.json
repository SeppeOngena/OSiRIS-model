{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug OSiRIS",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/OSiRIS",
            "args": ["TestSettings.json", "TestInputData.csv", "TestOutputData.csv"],
            // folder containing the Test*.json/.csv files
            "cwd": "${workspaceFolder}/test",
            "stopAtEntry": false,
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",

            "windows": {
                "program": "${fileDirname}\\${fileBasenameNoExtension}.exe",
                "cwd": "${fileDirname}",
                "environment": [
                    {
                        "name": "PATH",
                        "value": "C:\\Users\\songena\\vcpkg\\installed\\x64-mingw-dynamic\\bin;${env:PATH}"
                    }
                ],
                "miDebuggerPath": "C:\\msys64\\ucrt64\\bin\\gdb.exe"
            },

            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "build OSiRIS"
        }
    ]
}
